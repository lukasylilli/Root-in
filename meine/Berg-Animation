.pop { animation: pop .5s cubic-bezier(.34,1.56,.64,1) both; transform-box:fill-box; transform-origin:center; }
.vox-range { -webkit-appearance:none; appearance:none; height:6px; border-radius:999px;
  background:linear-gradient(90deg,#FFB84D,#FF7A6B); outline:none; }
.vox-range::-webkit-slider-thumb { -webkit-appearance:none; width:22px; height:22px; border-radius:50%;
  background:#fff; border:3px solid #FF7A6B; cursor:pointer; box-shadow:0 2px 8px rgba(0,0,0,.35); }
.vox-range::-moz-range-thumb { width:22px; height:22px; border-radius:50%; background:#fff;
  border:3px solid #FF7A6B; cursor:pointer; }
`;

const font = "'Vazirmatn', sans-serif";
const S = {
  wrap: { fontFamily: font, maxWidth: 440, margin: "0 auto", padding: 16, boxSizing: "border-box" },
  card: { borderRadius: 28, overflow: "hidden", background: "#0A1029",
    boxShadow: "0 24px 60px rgba(6,10,30,.55), inset 0 0 0 1px rgba(255,255,255,.06)" },
  scene: { position: "relative", width: "100%", aspectRatio: "380 / 540", background: "#0A1029" },
  hud: { position: "absolute", top: 18, right: 18, textAlign: "right" },
  pctBox: { display: "flex", alignItems: "baseline", justifyContent: "flex-end", gap: 2,
    fontFamily: "'Space Grotesk', sans-serif", color: "#fff", lineHeight: 1,
    textShadow: "0 2px 12px rgba(0,0,0,.4)" },
  pctNum: { fontSize: 52, fontWeight: 700, letterSpacing: -1 },
  pctSign: { fontSize: 22, fontWeight: 600, opacity: 0.85 },
  hudSub: { display: "flex", alignItems: "center", justifyContent: "flex-end", gap: 8, marginTop: 4 },
  levelPill: { fontFamily: "'Space Grotesk', sans-serif", fontSize: 13, fontWeight: 700, color: "#3A2607",
    background: "linear-gradient(180deg,#FFD880,#FFB84D)", padding: "2px 10px", borderRadius: 999 },
  hudFa: { fontSize: 13, color: "#D6DEF3", fontWeight: 500 },
  summitBadge: { position: "absolute", top: 90, left: "50%", transform: "translateX(-50%)",
    background: "rgba(255,122,107,.95)", color: "#fff", fontWeight: 700, fontSize: 15,
    padding: "8px 16px", borderRadius: 999, boxShadow: "0 8px 24px rgba(255,122,107,.4)", whiteSpace: "nowrap" },
  panel: { padding: "16px 18px 18px", background: "linear-gradient(180deg,#0A1029,#0E1638)",
    borderTop: "1px solid rgba(255,255,255,.06)" },
  statusRow: { display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 },
  panelTitle: { fontSize: 13, fontWeight: 700, color: "#8293BC" },
  statusFa: { fontSize: 13, fontWeight: 500, color: "#FFD37E" },
  track: { height: 8, borderRadius: 999, background: "rgba(255,255,255,.07)", overflow: "hidden" },
  trackFill: { height: "100%", borderRadius: 999,
    background: "linear-gradient(90deg,#FFB84D,#FF7A6B)", transition: "width .25s ease" },
  chips: { display: "flex", gap: 6, marginTop: 12, justifyContent: "space-between" },
  chip: { flex: 1, textAlign: "center", fontFamily: "'Space Grotesk', sans-serif", fontSize: 12,
    fontWeight: 700, padding: "6px 0", borderRadius: 10, transition: "all .25s ease" },
  controls: { marginTop: 18, padding: "16px 18px", borderRadius: 20, background: "#141C3A",
    boxShadow: "inset 0 0 0 1px rgba(255,255,255,.05)" },
  controlHead: { fontSize: 12, color: "#8293BC", marginBottom: 12, fontWeight: 500 },
  range: { width: "100%", margin: "4px 0 16px" },
  btnRow: { display: "flex", gap: 8, flexWrap: "wrap" },
  primaryBtn: { flex: "1 1 100%", padding: "12px", borderRadius: 14, border: "none", cursor: "pointer",
    fontFamily: font, fontSize: 15, fontWeight: 700, color: "#fff",
    background: "linear-gradient(180deg,#FF8C6B,#FF6B6B)", boxShadow: "0 6px 18px rgba(255,107,107,.35)" },
  chipBtn: { flex: 1, padding: "9px 0", borderRadius: 12, border: "1px solid rgba(255,255,255,.1)",
    cursor: "pointer", background: "transparent", color: "#D6DEF3", fontFamily: font, fontSize: 13, fontWeight: 600 },
};
