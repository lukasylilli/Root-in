<?xml version="1.0" encoding="utf-8"?>
<!-- Beschreibt das Home-Screen-Widget gegenüber Android (siehe PLAN.md
     Phase 10). updatePeriodMillis ist auf 30 Minuten gesetzt; die App
     stößt zusätzlich bei jeder Änderung eine sofortige Aktualisierung an
     (HomeWidget.updateWidget in home_widget_service.dart). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/root_in_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
